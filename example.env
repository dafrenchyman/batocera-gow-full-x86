# Copy this file to .env and replace the sample values for your installation.
# .env is ignored; keep this example free of personal settings and credentials.
# Never put private-key contents in either file.
#
# To export .env into a POSIX-compatible shell:
#   set -a
#   . ./.env
#   set +a
#
# Installed host tools load a file only when --env-file selects it explicitly.
# Settings precedence is command flags > exported values > selected file > defaults.
# Nothing discovers .env automatically, expands variables in it, or exports it.

# Required for remote commands: username@IP, username@hostname, or an SSH alias.
# 192.0.2.10 is a documentation address, not a working test server.
BATOCERA_GOW_SSH_TARGET=your-user@192.0.2.10

# Optional key-file path. Omit to use normal OpenSSH config/agent authentication.
# BATOCERA_GOW_SSH_IDENTITY_FILE=/absolute/path/to/private-key

# Required only for commands that modify an explicitly chosen remote deployment.
# This selection grants no permission to deploy, publish, register or restart.
# BATOCERA_GOW_DEPLOYMENT_ROOT=/srv/batocera-gow

# Existing read-only content bind sources on the Docker host, not the SSH client.
# Keep the fixed /home/retro/userdata/{roms,bios} destinations and :ro.
# Wolf TOML does not interpolate these variables; use ContentRoots.wolf_mounts().
BATOCERA_GOW_ROMS_ROOT=/srv/batocera/roms
BATOCERA_GOW_BIOS_ROOT=/srv/batocera/bios
